{
  "name": "waifu-agent-usage",
  "version": "1.0.1",
  "releaseVersion": "1.0a",
  "private": true,
  "description": "A local AI coding usage dashboard with Lite and Waifu editions, independently maintained by Sylva1027.",
  "author": "Sylva1027",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sylva1027/waifu-agent-usage.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "waifu-agent-usage": "./src/cli.js",
    "codex-usage": "./src/cli.js",
    "cud": "./src/cli.js"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p tsconfig.checkjs.json",
    "lint": "biome check --formatter-enabled=false .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "native:build": "pwsh -NoProfile -File native/windows-source-proof/build.ps1",
    "native:check": "pwsh -NoProfile -File native/windows-source-proof/build.ps1 -Check",
    "package:release": "node scripts/package-release.mjs",
    "package:check": "node scripts/check-release.mjs",
    "skins:prepare": "node scripts/prepare-skin-assets.mjs prepare",
    "skins:check": "node scripts/prepare-skin-assets.mjs check",
    "skins:check:sources": "node scripts/prepare-skin-assets.mjs check-sources",
    "skins:palette": "node scripts/check-skin-palettes.mjs",
    "skins:candidates": "node scripts/skin-palette/generate-cli.mjs",
    "skins:review": "node scripts/skin-palette/review-cli.mjs",
    "skins:quality": "node scripts/skin-palette/review-cli.mjs verify",
    "summary": "node src/cli.js summary",
    "serve": "node src/cli.js run",
    "preview:gemini": "node scripts/gemini-ambient-preview.mjs",
    "visuals:build": "esbuild node_modules/three/build/three.module.js --bundle --format=esm --minify --legal-comments=inline --outfile=public/dev/waifu-visuals/three.js",
    "visuals:build:runtime": "node scripts/waifu-visuals/build-runtime.mjs",
    "visuals:serve": "npm run visuals:build && esbuild --servedir=public --serve=127.0.0.1:4178"
  },
  "engines": {
    "node": ">=23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "three": "0.187.0",
    "typescript": "5.9.3"
  }
}
